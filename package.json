    "test:user-scope": "node --experimental-strip-types --test app/lib/user-scope.test.ts app/lib/github-auth.server.test.ts",
    "test:cloud-state": "node --experimental-strip-types --test app/lib/bounded-json.test.ts app/lib/cloud-state-handlers.test.ts",
    "test": "npm run test:agent && npm run test:user-scope && npm run test:cloud-state"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
