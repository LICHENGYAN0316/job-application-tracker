{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:agent": "node --experimental-strip-types --test app/lib/career-navigator.test.ts app/lib/agent-service.server.test.ts app/lib/agent-actions.server.test.ts app/lib/agent-admin.server.test.ts app/lib/agent-admin.sqlite.test.ts",
    "test:user-scope": "node --experimental-strip-types --test app/lib/user-scope.test.ts app/lib/github-auth.server.test.ts",
    "test:cloud-state": "node --experimental-strip-types --test app/lib/bounded-json.test.ts app/lib/cloud-state-handlers.test.ts",
    "test": "npm run test:agent && npm run test:user-scope && npm run test:cloud-state"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
